# =============================================================================
# InvStorage — Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in real values before starting.
# NOTE: All secrets in this file are placeholders. Do NOT commit real values.
# =============================================================================

# --- AI Agent (OpenClaw) ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENCLAW_GATEWAY_TOKEN=your_openclaw_gateway_token_here

# --- MSRP Lookup (SerpAPI — optional) ---
SERPAPI_KEY=your_serpapi_key_here

# --- API Authentication (optional — leave blank for open local dev) ---
# Set this to a secure random string to require API key auth on mutating routes
INVSTORAGE_API_KEY=your_invstorage_api_key_here

# =============================================================================
# Database & Cache Configurations
# =============================================================================

# --- Main PostgreSQL Database (Postgres 15/16 + pgvector) ---
# Local Docker Compose default: postgresql://admin:your_db_password@db:5432/inventory?schema=public
# Cloud VM native default:     postgresql://admin:your_db_password@localhost:5432/inventory?schema=public
DATABASE_URL=postgresql://admin:your_db_password@localhost:5432/inventory?schema=public

# --- Redis (BullMQ Job Queue & Session Store) ---
# Docker Compose default: redis://redis:6379
# Cloud VM native default: redis://localhost:6379
REDIS_URL=redis://localhost:6379

# --- Vault Backup Database ---
VAULT_DATABASE_URL=postgresql://vault:your_vault_password@localhost:5436/vault_spm1

# --- Central Data Lake ---
DATALAKE_USER=datalake
DATALAKE_PASSWORD=your_datalake_password_here
DESTINATION__POSTGRES__CREDENTIALS=postgresql://datalake:your_datalake_password_here@localhost:5435/central_lake

# =============================================================================
# AI Vision & Embeddings Subsystems
# =============================================================================

# --- Vision Provider ---
# Options:
#   - auto   : Attempts connection to Ollama; falls back to mock fixtures if unavailable
#   - mock   : Deterministic mock vision fixtures (used in cloud VM and automated tests)
#   - ollama : Enforces real local Ollama server (e.g. on Node A GPU)
VISION_PROVIDER=auto
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3-vl

# --- CLIP Vector Embeddings ---
# Options:
#   - auto    : Calls CLIP microservice; falls back to deterministic embedding if unavailable
#   - mock    : Generates 512-dim normalized embeddings without local Python service
#   - service : Calls Python FastAPI CLIP service at CLIP_SERVICE_URL
CLIP_PROVIDER=auto
CLIP_SERVICE_URL=http://localhost:8100

# =============================================================================
# Storage & E-Commerce Services
# =============================================================================

# --- MinIO S3-Compatible Storage ---
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=your_minio_access_key_here
MINIO_SECRET_KEY=your_minio_secret_key_here
MINIO_BUCKET=inventory
MINIO_USE_SSL=false
NEXT_PUBLIC_MINIO_ENDPOINT=http://localhost:9000
NEXT_PUBLIC_MINIO_BUCKET=inventory

# --- Medusa Sales Backend ---
MEDUSA_BACKEND_URL=http://localhost:9500
MEDUSA_ADMIN_EMAIL=admin@invstorage.local
MEDUSA_ADMIN_PASSWORD=your_medusa_admin_password_here

# --- QR Code Base URL ---
NEXT_PUBLIC_HOST_IP=localhost

# --- Service Dashboard URLs (for frontend links) ---
NEXT_PUBLIC_MEDUSA_URL=http://localhost:9500
NEXT_PUBLIC_N8N_URL=http://localhost:5678
NEXT_PUBLIC_ERPNEXT_URL=http://localhost:8090
NEXT_PUBLIC_OPENCLAW_URL=http://localhost:18789
NEXT_PUBLIC_ADMINER_URL=http://localhost:8080
NEXT_PUBLIC_NOCODB_URL=http://localhost:8086

# =============================================================================
# InvStorage AI Worker — Dockerfile
# =============================================================================
# Lightweight Node.js container for running the BullMQ AI vision worker.
# Uses tsx to execute TypeScript directly without a build step.
# =============================================================================

FROM node:22-alpine

WORKDIR /app

# Install system deps for native modules
RUN apk add --no-cache libc6-compat openssl

# Copy dependency files
COPY package.json package-lock.json ./

# Install all dependencies (including devDependencies for tsx)
RUN npm ci

# Copy the Prisma schema and generate the client
COPY prisma ./prisma/
COPY prisma.config.ts ./
RUN npx prisma generate

# Copy source code
COPY src ./src/
COPY tsconfig.json ./

# Run the worker
CMD ["npm", "run", "worker"]
